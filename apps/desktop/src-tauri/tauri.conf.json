{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent Pin",
  "version": "0.1.0",
  "identifier": "dev.agentpin.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Pin",
        "width": 180,
        "height": 164,
        "minWidth": 54,
        "minHeight": 70,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A floating status pin for Claude Code, Codex, and Antigravity",
    "longDescription": "Agent Pin shows a small always-on-top status overlay for Claude Code, Codex, and Antigravity sessions."
  }
}
