#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"

state_dir = ENV.fetch("AGENT_PIN_HOME", File.join(Dir.home, ".agent-pin"))
event_file = File.join(state_dir, "events.jsonl")
FileUtils.mkdir_p(state_dir)

now = Time.now.to_i
Dir.chdir(Dir.home) do
  File.open(event_file, "a") do |file|
    file.flock(File::LOCK_EX)
    %w[claude codex antigravity].each do |provider|
      file.puts(JSON.generate(
        provider: provider,
        status: "idle",
        cwd: Dir.pwd,
        detail: "reset",
        event: "ManualReset",
        timestamp: now
      ))
    end
  end
end
